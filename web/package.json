{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/register.mjs --test \"src/**/*.test.ts\" \"test/db/totp.test.ts\"",
    "test:watch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/register.mjs --test --watch \"src/**/*.test.ts\"",
    "verify": "npm run typecheck && npm run lint && npm run check:migrations && npm test",
    "test:db": "node ../scripts/lib/with-idle-timeout.mjs 240 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/register.mjs --test --test-concurrency=1 \"test/db/**/*.db.test.ts\"",
    "check:migrations": "node ../scripts/check-migrations.mjs",
    "db:migrate": "node ../scripts/lib/with-idle-timeout.mjs 120 node ../scripts/apply-migrations.mjs",
    "db:migrate:dry": "node ../scripts/apply-migrations.mjs --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@daily-co/daily-js": "^0.92.2",
    "@sentry/nextjs": "11.2.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "ffmpeg-static": "^5.3.0",
    "libheif-js": "^1.23.2",
    "nepali-date-converter": "^3.4.0",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.19.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
