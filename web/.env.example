# TalentYak — environment variable names only.
#
# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way. Never commit a real value, never paste one into a document or a chat.
#
# Only NEXT_PUBLIC_ variables reach the browser. Everything else is server-only,
# and the naming is the first line of defence — a secret must never be given a
# NEXT_PUBLIC_ name to "make it work" on the client.

# --- Supabase ---------------------------------------------------------------
# Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses every row-level security policy in the database.
SUPABASE_SERVICE_ROLE_KEY=

# Personal Access Token from https://supabase.com/dashboard/account/tokens
# Needed only to APPLY MIGRATIONS — the service-role key cannot create tables.
# Safe to revoke once the schema is built; nothing at runtime uses it.
SUPABASE_ACCESS_TOKEN=

# --- Stripe -----------------------------------------------------------------
# Use TEST keys (sk_test_…) until live billing is approved. See LIVE_BILLING.
STRIPE_SECRET_KEY=
# The signing secret of the endpoint that will actually deliver to this
# deployment. A `stripe listen` secret is NOT the deployed endpoint's secret.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional. If set, the webhook refuses events from any other Stripe account,
# so a stray endpoint pointed at this deployment cannot write payment records.
STRIPE_ACCOUNT_ID=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "TalentYak <notifications@talentyak.com>".
# Email stays switched off until both RESEND_API_KEY and EMAIL_FROM are set.
# Configuring this does NOT configure Supabase Auth's own SMTP — that is a
# separate setting in the Supabase dashboard.
EMAIL_FROM=

# Public support address shown to customers. Hidden until set. Only fill this in
# with an address a person actually reads: it is presented as somewhere to reply.
SUPPORT_EMAIL=

# --- Video calls (Daily) ----------------------------------------------------
# RESERVED, AND NOTHING READS IT YET. Video calls are unbuilt and Daily is still
# an unverified candidate (ARCHITECTURE.md §9). The name is here so the key has
# somewhere to live; setting it switches nothing on by itself.
DAILY_API_KEY=

# --- Scheduled work ---------------------------------------------------------
# Required. The job processor refuses to run without it rather than serving an
# unauthenticated endpoint that can send mail in our name.
# Generate one with:  openssl rand -base64 32
CRON_SECRET=

# --- Billing readiness ------------------------------------------------------
# Leave unset or "false" for sandbox. Setting it to "true" is necessary but NOT
# sufficient to take real money: every policy in the register must also be
# approved. See src/lib/policy/live-gate.ts.
LIVE_BILLING=false

# --- Object storage (Cloudflare R2, ceremony recordings) --------------------
# Only used by the retained pandit ceremony-recording feature, which is not
# publicly sellable. Nothing has ever been stored here, so the name was free to
# change with the brand. Not needed for fitness.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=talentyak-recordings

# --- Site -------------------------------------------------------------------
# The origin this deployment serves from. Used for absolute URLs in metadata,
# emails, and Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
